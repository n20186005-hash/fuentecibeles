---
const { compact = false } = Astro.props;
---
<div class:list={["brand", compact && "brand--compact"]} aria-label="Fuente de Cibeles">
  <svg class="brand__mark" viewBox="0 0 64 64" role="img" aria-hidden="true">
    <circle cx="32" cy="32" r="29" fill="none" stroke="currentColor" stroke-width="1.8"/>
    <circle cx="32" cy="28" r="7.5" fill="none" stroke="currentColor" stroke-width="1.8"/>
    <path d="M18 42c4-5 9-7 14-7s10 2 14 7M12 48h40M20 48c1-5 4-8 7-10M44 48c-1-5-4-8-7-10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    <path d="M13 23h8M43 23h8M32 8v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  </svg>
  <span class="brand__text">
    <strong>Fuente de Cibeles</strong>
    <small>Roma Norte · CDMX</small>
  </span>
</div>
