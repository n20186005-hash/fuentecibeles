---
import BaseLayout from '../layouts/BaseLayout.astro';
import { attraction, faqs, photos, SITE_NAME } from '../data/site';

export const prerender = true;

const title = `${attraction.name} CDMX: historia, cómo llegar y mapa`;
const description =
  `Descubre la ${attraction.name} en Roma Norte, CDMX: historia de la réplica de Madrid, ` +
  'ubicación exacta y Plus Code, cómo llegar en Metro y Metrobús, fotos y lugares cercanos.';
const siteUrl = Astro.site ? new URL('/', Astro.site).toString() : undefined;
const origin = Astro.site ? Astro.site.origin : undefined;
const heroImageUrl = origin ? new URL(attraction.imagePath, origin).toString() : attraction.imagePath;
const ogAlt = 'Fuente de Cibeles — réplica madrileña en la Plaza Villa de Madrid, Roma Norte, Ciudad de México';
const lastUpdated = '2026-09-29';

const orgSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${origin}/#organization`,
  name: 'fuentecibeles.com',
  alternateName: [attraction.formalName, 'Guía de la Fuente de Cibeles'],
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${origin}/icons/favicon.svg`
  }
};

const websiteSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${origin}/#website`,
  name: SITE_NAME,
  alternateName: [attraction.name, `${attraction.city} ${attraction.name}`, `${attraction.regionShort} ${attraction.name}`],
  description,
  url: siteUrl,
  inLanguage: 'es-MX',
  publisher: { '@id': `${origin}/#organization` }
};

const attractionSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LandmarksOrHistoricalBuildings'],
  '@id': `${origin}/#attraction`,
  name: attraction.name,
  alternateName: [
    attraction.formalName,
    attraction.englishName,
    'Fuente de las Cibeles',
    'Fuente de los Cibeles',
    'Plaza Villa de Madrid',
    `${attraction.city} ${attraction.name}`,
    `${attraction.regionShort} ${attraction.name}`
  ],
  description,
  url: siteUrl,
  image: photos.map((photo) => ({
    '@type': 'ImageObject',
    url: origin ? new URL(photo.src, origin).toString() : photo.src,
    caption: photo.alt,
    creditText: photo.credit,
    license: 'https://creativecommons.org/licenses/by-sa/4.0/'
  })),
  isAccessibleForFree: true,
  publicAccess: true,
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${origin}/#webpage` },
  address: {
    '@type': 'PostalAddress',
    streetAddress: attraction.streetAddress,
    addressLocality: attraction.neighborhood,
    addressRegion: attraction.city,
    postalCode: attraction.postalCode,
    addressCountry: attraction.countryCode
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: attraction.latitude,
    longitude: attraction.longitude
  },
  hasMap: attraction.mapUrl,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59'
    }
  ],
  touristType: ['Fuente monumental', 'Arte público', 'Réplica histórica', 'Atracción urbana'],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: attraction.rating,
    reviewCount: attraction.reviewCount,
    bestRating: 5,
    worstRating: 1
  },
  sameAs: [attraction.mapUrl, attraction.govUrl, attraction.boroughUrl, attraction.wikidataUrl]
};

const webpageSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${origin}/#webpage`,
  url: siteUrl,
  name: title,
  description,
  inLanguage: 'es-MX',
  datePublished: lastUpdated,
  dateModified: lastUpdated,
  isPartOf: { '@id': `${origin}/#website` },
  about: { '@id': `${origin}/#attraction` },
  primaryImageOfPage: { '@type': 'ImageObject', url: heroImageUrl }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Ciudad de México' },
    { '@type': 'ListItem', position: 3, name: 'Cuauhtémoc' },
    { '@type': 'ListItem', position: 4, name: 'México' },
    { '@type': 'ListItem', position: 5, name: attraction.name, item: `${origin}/#inicio` }
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};

const schema = [orgSchema, websiteSchema, webpageSchema, attractionSchema, breadcrumbSchema, faqSchema];
---

<BaseLayout {title} {description} {schema} ogImage={attraction.imagePath} ogImageAlt={ogAlt}>
  <section id="inicio" class="hero">
    <div class="hero-media">
      <img src={photos[0].src} alt={photos[0].alt} width="1600" height="1200" decoding="async" referrerpolicy="no-referrer" />
    </div>
    <div class="hero-shade"></div>
    <div class="shell hero-content">
      <p class="eyebrow light">Roma Norte · Plaza Villa de Madrid · Ciudad de México</p>
      <h1>Fuente de <em>Cibeles</em><span class="h1-place">Plaza Villa de Madrid · Roma Norte · Ciudad de México</span></h1>
      <p class="hero-lede">Un gesto madrileño convertido en punto de encuentro chilango: agua, mitología clásica y vida de barrio en una de las glorietas más reconocibles de la Roma.</p>
      <div class="hero-actions">
        <a class="button button--light" href="#visita">Planear la visita</a>
        <a class="button button--ghost" href={attraction.mapUrl} target="_blank" rel="noreferrer">Abrir en Google Maps</a>
      </div>
      <div class="quick-stats" aria-label="Datos rápidos">
        <div><strong>1980</strong><span>inauguración en CDMX</span></div>
        <div><strong>Gratis</strong><span>espacio público</span></div>
        <div><strong>{attraction.rating} / 5</strong><span>{attraction.reviewCount.toLocaleString('es-MX')} reseñas en Google*</span></div>
      </div>
    </div>
    <p class="photo-credit hero-credit">Foto: <a href={photos[0].source}>{photos[0].credit}</a> · {photos[0].license}</p>
  </section>

  <section class="intro-band">
    <div class="shell">
      <nav class="crumb" aria-label="Ruta de ubicación">
        <a href="/">Inicio</a><span aria-hidden="true">›</span>
        <span>Ciudad de México</span><span aria-hidden="true">›</span>
        <span>CDMX</span><span aria-hidden="true">›</span>
        <span>México</span><span aria-hidden="true">›</span>
        <strong>{attraction.name}</strong>
      </nav>
      <div class="intro-grid">
        <div>
          <p class="eyebrow">La plaza</p>
          <h2>Una fuente monumental que funciona como sala de estar urbana.</h2>
        </div>
        <div class="prose large">
          <p>
            La <strong>Fuente de Cibeles</strong> de la <strong>Ciudad de México</strong> —réplica de la fuente homónima de Madrid y corazón de la
            <strong> Plaza Villa de Madrid</strong>— ocupa la antigua plaza de Miravalle, rediseñada para recibir este conjunto escultórico inaugurado en
            1980 como símbolo de los vínculos entre México y España. Hoy es una referencia para orientarse en Roma Norte y un escenario cotidiano de
            encuentros, terrazas, paseos en bicicleta y fines de semana de barrio.
          </p>
          <p>
            Al visitar la <strong>Fuente de Cibeles</strong> conviene enlazar con otros puntos de interés cercanos de Roma Norte y la Condesa: la
            <strong> Plaza Río de Janeiro</strong>, el corredor de <strong>Álvaro Obregón</strong>, el <strong>Ángel de la Independencia</strong> sobre
            Paseo de la Reforma y el <strong>Parque México</strong>, todos a 8–20 minutos a pie desde la glorieta.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="historia" class="section shell">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">Historia & simbolismo</p>
        <h2>De Madrid a la Roma: la historia de la Fuente de Cibeles y su réplica mexicana.</h2>
      </div>
      <p>La versión mexicana fue inaugurada en 1980 como obsequio de la comunidad española residente en la capital y como símbolo de los vínculos entre México y España. En 2011 fue objeto de una restauración integral.</p>
    </div>

    <div class="history-grid">
      <figure class="image-card image-card--tall">
        <img src={photos[1].src} alt={photos[1].alt} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
        <figcaption>Foto: <a href={photos[1].source}>{photos[1].credit}</a> · {photos[1].license}</figcaption>
      </figure>
      <div class="timeline">
        <article><span>1777–1792</span><h3>El modelo madrileño</h3><p>El arquitecto Ventura Rodríguez concibió la fuente original. Francisco Gutiérrez realizó a Cibeles y su carro; Roberto Michel talló los leones asociados con Atalanta e Hipómenes.</p></article>
        <article><span>1980</span><h3>La plaza cambia de nombre</h3><p>La antigua plaza de Miravalle se adapta para alojar la réplica y pasa a llamarse Plaza Villa de Madrid. La inauguración reúne a autoridades mexicanas y madrileñas.</p></article>
        <article><span>2011</span><h3>Restauración</h3><p>El conjunto es restaurado y reafirma su papel como hito urbano de Roma Norte.</p></article>
        <article><span>Hoy</span><h3>Punto de encuentro</h3><p>La glorieta conecta cafés, galerías, comercio de barrio, rutas turísticas y recorridos a pie entre Roma, Condesa y Reforma.</p></article>
      </div>
    </div>

    <div class="fact-strip">
      <div><span>≈ 12.5 m</span><p>longitud del grupo escultórico</p></div>
      <div><span>≈ 5.5 m</span><p>altura</p></div>
      <div><span>≈ 12 t</span><p>peso aproximado</p></div>
      <div><span>Neoclásico</span><p>lenguaje e iconografía</p></div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="shell architecture-grid">
      <div class="prose prose--light">
        <p class="eyebrow light">Arquitectura</p>
        <h2>Cibeles, un carro y dos leones en medio del pulso de la ciudad.</h2>
        <p>La composición coloca a la diosa Cibeles en el centro, elevada sobre un carro tirado por dos leones. La iconografía clásica contrasta con el arbolado, las fachadas porfirianas y la vida contemporánea de Roma Norte.</p>
        <p>Para apreciar el conjunto, no te quedes sólo con la vista frontal: rodear la glorieta permite leer la volumetría, el perfil de los leones y la relación de la fuente con las avenidas Oaxaca, Durango, Medellín y El Oro.</p>
      </div>
      <figure class="image-card image-card--wide">
        <img src={photos[2].src} alt={photos[2].alt} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
        <figcaption>Foto: <a href={photos[2].source}>{photos[2].credit}</a> · {photos[2].license}</figcaption>
      </figure>
    </div>
  </section>

  <section id="visita" class="section shell">
    <div class="section-heading">
      <p class="eyebrow">Guía práctica</p>
      <h2>Cómo visitar la Fuente de Cibeles sin convertir el paseo en una carrera.</h2>
    </div>

    <div class="practical-grid">
      <article class="practical-card featured">
        <span class="number">01</span>
        <h3>Mejor momento</h3>
        <p><strong>08:00–10:30</strong> para una plaza más tranquila y luz suave. <strong>17:00–19:00</strong> para ambiente de barrio, terrazas y luz lateral.</p>
        <small>El agua ornamental puede detenerse por mantenimiento, eventos o ajustes operativos.</small>
      </article>
      <article class="practical-card">
        <span class="number">02</span>
        <h3>Tiempo recomendado</h3>
        <p>20–40 min para la fuente. Añade 2–4 h si vas a caminar por Roma Norte y enlazar con Reforma o Condesa.</p>
      </article>
      <article class="practical-card">
        <span class="number">03</span>
        <h3>Entrada / costo</h3>
        <p>Acceso gratuito. No existe boleto de entrada para el espacio público de la plaza.</p>
      </article>
      <article class="practical-card">
        <span class="number">04</span>
        <h3>Horario</h3>
        <p>La glorieta es espacio público de acceso exterior continuo; no tiene horario de taquilla. Eventos u obras pueden modificar accesos puntualmente.</p>
      </article>
    </div>

    <div class="route-block">
      <div>
        <p class="eyebrow">Ruta sugerida · 90 minutos</p>
        <h3>Una vuelta que aprovecha el contexto, no sólo la foto.</h3>
      </div>
      <ol class="route-list">
        <li><span>1</span><div><strong>Llega por Durango</strong><p>Entra caminando desde Insurgentes y deja que la fuente aparezca entre árboles y terrazas.</p></div></li>
        <li><span>2</span><div><strong>Rodea la glorieta</strong><p>Busca la frontal de Cibeles y luego los perfiles para entender el carro y los dos leones.</p></div></li>
        <li><span>3</span><div><strong>Sube por Oaxaca</strong><p>Observa la escala del conjunto con el tráfico y las fachadas como marco urbano.</p></div></li>
        <li><span>4</span><div><strong>Cierra con Roma Norte</strong><p>Continúa hacia Plaza Río de Janeiro o Álvaro Obregón para cafés, arquitectura y galerías.</p></div></li>
      </ol>
    </div>
  </section>

  <section id="fotos" class="section photo-section">
    <div class="shell photo-layout">
      <figure class="image-card image-card--heroish">
        <img src={photos[3].src} alt={photos[3].alt} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
        <figcaption>Foto: <a href={photos[3].source}>{photos[3].credit}</a> · {photos[3].license}</figcaption>
      </figure>
      <div class="photo-copy">
        <p class="eyebrow">Fotografía</p>
        <h2>Fotos de la Fuente de Cibeles: tres encuadres que cuentan historias distintas.</h2>
        <div class="shot-list">
          <div><span>A</span><p><strong>Frontal simétrico.</strong> Colócate en un paso peatonal seguro y usa el eje del carro para una composición clásica.</p></div>
          <div><span>B</span><p><strong>Diagonal con arbolado.</strong> Desde Oaxaca o Durango, incluye copas y terrazas para situar la fuente en Roma Norte.</p></div>
          <div><span>C</span><p><strong>Detalle de los leones.</strong> Un encuadre más cerrado funciona mejor cuando hay tránsito o demasiada gente alrededor.</p></div>
        </div>
        <p class="note">No te detengas en la calzada para tomar fotos. La glorieta está rodeada por circulación vehicular; utiliza pasos peatonales y banquetas.</p>
      </div>
    </div>
    <div class="shell gallery-grid">
      {
        photos.map((photo, index) => (
          <figure>
            <img src={photo.src} alt={photo.alt} width="1600" height="1200" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" />
            <figcaption>
              Foto: <a href={photo.source}>{photo.credit}</a> · {photo.license}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="section section--sand" id="como-llegar">
    <div class="shell">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">Cómo llegar</p>
          <h2>Cómo llegar a la Fuente de Cibeles en Metro, Metrobús y a pie.</h2>
        </div>
        <p>
          La glorieta ocupa la Plaza Villa de Madrid, donde se cruzan las avenidas Oaxaca, Durango, Medellín y El Oro, en el corazón de
          Roma Norte. Metro Línea 1, Metrobús de Insurgentes (estación Durango), ECOBICI y los circuitos turísticos dejan el punto a una
          distancia caminable.
        </p>
      </div>

      <div class="transport-grid">
        <article><span>Metro</span><h3>Línea 1</h3><p>Insurgentes y Sevilla son las estaciones útiles para llegar caminando por Roma Norte. Desde Insurgentes, continúa por Álvaro Obregón, Oaxaca o Durango hasta Plaza Villa de Madrid.</p></article>
        <article><span>Metrobús</span><h3>Corredor Insurgentes</h3><p>La estación Durango (Línea 1 del Metrobús) es la parada práctica si vienes del norte o del sur: baja y continúa al poniente por Durango hasta la plaza.</p></article>
        <article><span>Bicicleta</span><h3>ECOBICI</h3><p>Hay estaciones de bici pública en el entorno inmediato de Plaza Villa de Madrid. Roma y Condesa tienen una red cómoda para trayectos cortos.</p></article>
        <article><span>Bus turístico</span><h3>Turibus / Capital Bus</h3><p>Los circuitos turísticos utilizan la glorieta como parada o punto de transferencia, útil si la visita forma parte de un recorrido amplio por CDMX.</p></article>
      </div>

      <div class="route-block">
        <div>
          <p class="eyebrow">Rutas paso a paso</p>
          <h3>Tres accesos a pie hacia Plaza Villa de Madrid.</h3>
        </div>
        <ol class="route-list">
          <li><span>1</span><div><strong>Metro Insurgentes (Línea 1)</strong><p>Sal hacia el poniente por Álvaro Obregón y baja por Oaxaca o Durango hasta que aparezca la glorieta. Es el acceso con más cafés y galerías en el camino; ≈ 15–20 min a pie.</p></div></li>
          <li><span>2</span><div><strong>Metro Sevilla (Línea 1)</strong><p>Otra alternativa hacia el sur de la colonia: continúa por Oaxaca o Durango para llegar de frente a la plaza y al conjunto escultórico; ≈ 15–20 min a pie.</p></div></li>
          <li><span>3</span><div><strong>Metrobús Durango (Insurgentes)</strong><p>Baja en la estación Durango y continúa al poniente por la calle del mismo nombre hasta Plaza Villa de Madrid; ≈ 8–10 min a pie.</p></div></li>
        </ol>
      </div>

      <p class="map-note">
        Punto exacto para el navegador: Plaza Villa de Madrid, Roma Norte, Cuauhtémoc, CP 06700 · código Plus
        <strong>{attraction.plusCode}</strong>. Si prefieres trazar la ruta en movimiento, abre la ficha en
        <a href={attraction.mapUrl} target="_blank" rel="noopener noreferrer">Google Maps</a>.
      </p>

      <div class="parking-card">
        <div><p class="eyebrow">Estacionamiento</p><h3>Si llegas en auto</h3></div>
        <div><p>No cuentes con un lugar junto a la fuente. Busca estacionamientos privados sobre Puebla, Durango o Medellín y revisa la señalización vigente de parquímetros y zonas restringidas antes de dejar el vehículo.</p><p class="muted">Tarifas, horarios y disponibilidad cambian; confirma directamente con el estacionamiento el día de tu visita.</p></div>
      </div>
    </div>
  </section>

  <section class="section shell map-section">
    <div class="map-copy">
      <p class="eyebrow">Ubicación</p>
      <h2>Ubicación de la Fuente de Cibeles: Plaza Villa de Madrid, Roma Norte.</h2>
      <p>{attraction.address}</p>
      <p>Código Plus: {attraction.plusCode} · coordenadas {attraction.latitude}, {attraction.longitude}</p>
      <p class="geo-chain">Roma Norte → Cuauhtémoc → Ciudad de México → CDMX → México</p>
      <a class="text-link" href={attraction.mapUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps →</a>
      <p class="map-note">¿Vienes en transporte público? Revisa las <a href="#como-llegar">rutas en Metro, Metrobús y a pie</a> antes de salir.</p>
      <p class="map-note">
        Para información oficial y actualizaciones de la zona, visita el
        <a href={attraction.govUrl} target="_blank" rel="noopener noreferrer"> {attraction.govLabel}</a>.
      </p>
    </div>
    <div class="map-frame">
      <iframe src={attraction.mapEmbedSrc} width="600" height="450" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="Mapa de la Fuente de Cibeles en Ciudad de México"></iframe>
    </div>
  </section>

  <section class="section section--ink">
    <div class="shell">
      <div class="section-heading split-heading on-dark">
        <div><p class="eyebrow light">Comer alrededor</p><h2>De pizza a mariscos: tres paradas para extender el paseo.</h2></div>
        <p>Roma Norte cambia rápido: revisa horario y disponibilidad antes de ir, especialmente en fines de semana.</p>
      </div>
      <div class="food-grid">
        <article><span>Frente a la plaza</span><h3>Cancino Cibeles</h3><p>Pizza, pasta y una ubicación que permite mantener la fuente dentro del paisaje del paseo.</p></article>
        <article><span>A unos minutos</span><h3>Contramar</h3><p>Un clásico de mariscos de la Roma, muy solicitado; la reserva suele ser conveniente.</p></article>
        <article><span>Para picar de todo</span><h3>Mercado Roma</h3><p>Formato de mercado gastronómico útil cuando el grupo quiere opciones distintas en un mismo lugar.</p></article>
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading">
      <p class="eyebrow">Cerca de Cibeles</p>
      <h2>Cerca de la Fuente de Cibeles: cuatro extensiones naturales del recorrido.</h2>
    </div>
    <div class="nearby-grid">
      <article><span>01</span><h3>Plaza Río de Janeiro</h3><p>Otra plaza emblemática de Roma Norte, rodeada de arquitectura histórica y cafés.</p><small>≈ 8–10 min a pie</small></article>
      <article><span>02</span><h3>Álvaro Obregón</h3><p>Camellón arbolado, fuentes, esculturas y uno de los paseos más característicos de la colonia.</p><small>≈ 10 min a pie</small></article>
      <article><span>03</span><h3>Ángel de la Independencia</h3><p>Conecta la visita con Paseo de la Reforma y uno de los símbolos urbanos más conocidos del país.</p><small>≈ 15–20 min a pie</small></article>
      <article><span>04</span><h3>Parque México</h3><p>Arquitectura art déco, áreas verdes y el corazón peatonal de la vecina Condesa.</p><small>≈ 15–20 min a pie</small></article>
    </div>
  </section>

  <section class="section section--sand">
    <div class="shell stay-grid">
      <div><p class="eyebrow">Dónde alojarse</p><h2>Elige barrio según el ritmo que quieras.</h2></div>
      <div class="stay-options">
        <article><h3>Roma Norte</h3><p>La mejor opción si quieres caminar a Cibeles, desayunos, restaurantes y galerías. Puede haber ruido nocturno en calles con bares.</p></article>
        <article><h3>Condesa</h3><p>Más verde y residencial, todavía a distancia caminable; funciona bien para quien prioriza parques y paseos tranquilos.</p></article>
        <article><h3>Juárez / Zona Rosa</h3><p>Práctica para Reforma y conexiones de transporte. Útil si la Fuente de Cibeles es una parada dentro de una agenda más amplia.</p></article>
      </div>
    </div>
  </section>

  <section id="fuentes" class="section shell sources-section">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">Fuentes y referencias</p>
        <h2>De dónde sale esta guía.</h2>
      </div>
      <p>El contenido se apoya en fuentes oficiales y fichas públicas; el sitio es informativo, independiente y no sustituye la información oficial vigente.</p>
    </div>
    <ul class="source-list">
      <li>
        <a href={attraction.govUrl} target="_blank" rel="noopener noreferrer">{attraction.govLabel}</a>
        <span>Ficha oficial del recinto en mexicocity.cdmx.gob.mx</span>
      </li>
      <li>
        <a href={attraction.boroughUrl} target="_blank" rel="noopener noreferrer">{attraction.boroughLabel}</a>
        <span>Registro e información territorial de la colonia Roma Norte</span>
      </li>
      <li>
        <a href={attraction.wikidataUrl} target="_blank" rel="noopener noreferrer">Wikidata — Fuente de Cibeles (Q129506)</a>
        <span>Identificador y referencias cruzadas del monumento</span>
      </li>
      <li>
        <a href={attraction.mapUrl} target="_blank" rel="noopener noreferrer">Google Maps — ficha del lugar</a>
        <span>Calificación 4.6 / 5 con {attraction.reviewCount.toLocaleString('es-MX')} reseñas y ubicación oficial</span>
      </li>
    </ul>
    <div class="source-notes">
      <p>
        <strong>Fotografías:</strong> todas las imágenes mostradas en este sitio web permanecen en propiedad de sus fotógrafos originales; la propiedad
        intelectual y los derechos de autor de cada fotografía corresponden a sus autores (Wikimedia Commons, licencia CC BY-SA 4.0). La atribución
        figura junto a cada imagen y en SOURCES.md.
      </p>
      <p>
        <strong>Actualización:</strong> contenido revisado por última vez el {new Intl.DateTimeFormat('es-MX', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(`${lastUpdated}T00:00:00`))}. La calificación de Google Maps puede cambiar con el tiempo.
      </p>
    </div>
  </section>

  <section id="faq" class="section shell faq-section">
    <div class="section-heading">
      <p class="eyebrow">Preguntas frecuentes</p>
      <h2>Lo esencial antes de ir.</h2>
    </div>
    <div class="faq-list">
      {faqs.map((item) => (
        <details>
          <summary>{item.q}<span aria-hidden="true">+</span></summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
    <p class="rating-note">* Calificación y número de reseñas proporcionados en la ficha de Google Maps indicada para este proyecto; pueden cambiar con el tiempo.</p>
  </section>
</BaseLayout>
