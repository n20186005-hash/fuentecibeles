---
import BaseLayout from '../layouts/BaseLayout.astro';
import { attraction, faqs, photos } from '../data/site';

const title = 'Fuente de Cibeles en Roma Norte | Guía de visita, historia y cómo llegar';
const description = 'Guía en español para visitar la Fuente de Cibeles de Ciudad de México: historia, arquitectura, transporte, estacionamiento, restaurantes, fotos y lugares cercanos.';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;

const attractionSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: attraction.name,
  alternateName: ['Fuente de las Cibeles', 'Cibeles Fountain'],
  description,
  ...(canonical ? { url: canonical } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Plaza Villa de Madrid, Roma Norte',
    addressLocality: 'Ciudad de México',
    addressRegion: 'CDMX',
    postalCode: '06700',
    addressCountry: 'MX'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: attraction.latitude,
    longitude: attraction.longitude
  },
  isAccessibleForFree: true,
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '00:00',
    closes: '23:59'
  }],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: attraction.rating,
    reviewCount: attraction.reviewCount,
    bestRating: 5,
    worstRating: 1
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};

const schema = [attractionSchema, faqSchema];
const mapEmbed = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d52739740.91450794!2d-138.18974899999998!3d19.420009799999992!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85d1ff378aa470c1%3A0xbd10aad29abc63c3!2sFuente%20de%20Cibeles!5e1!3m2!1ses-MX!2smx!4v1788742591749!5m2!1ses-MX!2smx&hl=es-MX';
---
<BaseLayout {title} {description} {schema}>
  <section id="inicio" class="hero">
    <div class="hero-media">
      <img src={photos[0].src} alt={photos[0].alt} width="1280" height="959" fetchpriority="high" decoding="async" referrerpolicy="no-referrer" />
    </div>
    <div class="hero-shade"></div>
    <div class="shell hero-content">
      <p class="eyebrow light">Roma Norte · Plaza Villa de Madrid</p>
      <h1>Fuente de <em>Cibeles</em></h1>
      <p class="hero-lede">Un gesto madrileño convertido en punto de encuentro chilango: agua, mitología clásica y vida de barrio en una de las glorietas más reconocibles de la Roma.</p>
      <div class="hero-actions">
        <a class="button button--light" href="#visita">Planear la visita</a>
        <a class="button button--ghost" href={attraction.mapUrl} target="_blank" rel="noreferrer">Abrir en Google Maps</a>
      </div>
      <div class="quick-stats" aria-label="Datos rápidos">
        <div><strong>1980</strong><span>inauguración en CDMX</span></div>
        <div><strong>Gratis</strong><span>espacio público</span></div>
        <div><strong>4.6 / 5</strong><span>22,693 reseñas en Google*</span></div>
      </div>
    </div>
    <p class="photo-credit hero-credit">Foto: <a href={photos[0].source}>{photos[0].credit}</a> · {photos[0].license}</p>
  </section>

  <section class="intro-band">
    <div class="shell intro-grid">
      <div>
        <p class="eyebrow">La plaza</p>
        <h2>Una fuente monumental que funciona como sala de estar urbana.</h2>
      </div>
      <div class="prose large">
        <p>La Fuente de Cibeles ocupa la antigua plaza de Miravalle, rediseñada como Plaza Villa de Madrid para recibir esta réplica del célebre conjunto madrileño. Hoy es una referencia para orientarse en Roma Norte y un escenario cotidiano de encuentros, terrazas, paseos en bicicleta y fines de semana de barrio.</p>
      </div>
    </div>
  </section>

  <section id="historia" class="section shell">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">Historia & simbolismo</p>
        <h2>De Madrid a la Roma: una réplica con identidad propia.</h2>
      </div>
      <p>La versión mexicana fue inaugurada en 1980 como obsequio de la comunidad española residente en la capital y como símbolo de los vínculos entre México y España. En 2011 fue objeto de una restauración integral.</p>
    </div>

    <div class="history-grid">
      <figure class="image-card image-card--tall">
        <img src={photos[1].src} alt={photos[1].alt} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
        <figcaption>Foto: <a href={photos[1].source}>{photos[1].credit}</a> · {photos[1].license}</figcaption>
      </figure>
      <div class="timeline">
        <article><span>1777–1792</span><h3>El modelo madrileño</h3><p>El arquitecto Ventura Rodríguez concibió la fuente original. Francisco Gutiérrez realizó a Cibeles y su carro; Roberto Michel talló los leones asociados con Atalanta e Hipómenes.</p></article>
        <article><span>1980</span><h3>La plaza cambia de nombre</h3><p>La antigua plaza de Miravalle se adapta para alojar la réplica y pasa a llamarse Plaza Villa de Madrid. La inauguración reúne a autoridades mexicanas y madrileñas.</p></article>
        <article><span>2011</span><h3>Restauración</h3><p>El conjunto es restaurado y reafirma su papel como hito urbano de Roma Norte.</p></article>
        <article><span>Hoy</span><h3>Punto de encuentro</h3><p>La glorieta conecta cafés, galerías, comercio de barrio, rutas turísticas y recorridos a pie entre Roma, Condesa y Reforma.</p></article>
      </div>
    </div>

    <div class="fact-strip">
      <div><span>≈ 12.5 m</span><p>longitud del grupo escultórico</p></div>
      <div><span>≈ 5.5 m</span><p>altura</p></div>
      <div><span>≈ 12 t</span><p>peso aproximado</p></div>
      <div><span>Neoclásico</span><p>lenguaje e iconografía</p></div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="shell architecture-grid">
      <div class="prose prose--light">
        <p class="eyebrow light">Arquitectura</p>
        <h2>Cibeles, un carro y dos leones en medio del pulso de la ciudad.</h2>
        <p>La composición coloca a la diosa Cibeles en el centro, elevada sobre un carro tirado por dos leones. La iconografía clásica contrasta con el arbolado, las fachadas porfirianas y la vida contemporánea de Roma Norte.</p>
        <p>Para apreciar el conjunto, no te quedes sólo con la vista frontal: rodear la glorieta permite leer la volumetría, el perfil de los leones y la relación de la fuente con las avenidas Oaxaca, Durango, Medellín y El Oro.</p>
      </div>
      <figure class="image-card image-card--wide">
        <img src={photos[2].src} alt={photos[2].alt} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
        <figcaption>Foto: <a href={photos[2].source}>{photos[2].credit}</a> · {photos[2].license}</figcaption>
      </figure>
    </div>
  </section>

  <section id="visita" class="section shell">
    <div class="section-heading">
      <p class="eyebrow">Guía práctica</p>
      <h2>Cómo visitar la Fuente de Cibeles sin convertir el paseo en una carrera.</h2>
    </div>

    <div class="practical-grid">
      <article class="practical-card featured">
        <span class="number">01</span>
        <h3>Mejor momento</h3>
        <p><strong>08:00–10:30</strong> para una plaza más tranquila y luz suave. <strong>17:00–19:00</strong> para ambiente de barrio, terrazas y luz lateral.</p>
        <small>El agua ornamental puede detenerse por mantenimiento, eventos o ajustes operativos.</small>
      </article>
      <article class="practical-card">
        <span class="number">02</span>
        <h3>Tiempo recomendado</h3>
        <p>20–40 min para la fuente. Añade 2–4 h si vas a caminar por Roma Norte y enlazar con Reforma o Condesa.</p>
      </article>
      <article class="practical-card">
        <span class="number">03</span>
        <h3>Entrada / costo</h3>
        <p>Acceso gratuito. No existe boleto de entrada para el espacio público de la plaza.</p>
      </article>
      <article class="practical-card">
        <span class="number">04</span>
        <h3>Horario</h3>
        <p>La glorieta es espacio público de acceso exterior continuo; no tiene horario de taquilla. Eventos u obras pueden modificar accesos puntualmente.</p>
      </article>
    </div>

    <div class="route-block">
      <div>
        <p class="eyebrow">Ruta sugerida · 90 minutos</p>
        <h3>Una vuelta que aprovecha el contexto, no sólo la foto.</h3>
      </div>
      <ol class="route-list">
        <li><span>1</span><div><strong>Llega por Durango</strong><p>Entra caminando desde Insurgentes y deja que la fuente aparezca entre árboles y terrazas.</p></div></li>
        <li><span>2</span><div><strong>Rodea la glorieta</strong><p>Busca la frontal de Cibeles y luego los perfiles para entender el carro y los dos leones.</p></div></li>
        <li><span>3</span><div><strong>Sube por Oaxaca</strong><p>Observa la escala del conjunto con el tráfico y las fachadas como marco urbano.</p></div></li>
        <li><span>4</span><div><strong>Cierra con Roma Norte</strong><p>Continúa hacia Plaza Río de Janeiro o Álvaro Obregón para cafés, arquitectura y galerías.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section photo-section">
    <div class="shell photo-layout">
      <figure class="image-card image-card--heroish">
        <img src={photos[3].src} alt={photos[3].alt} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
        <figcaption>Foto: <a href={photos[3].source}>{photos[3].credit}</a> · {photos[3].license}</figcaption>
      </figure>
      <div class="photo-copy">
        <p class="eyebrow">Fotografía</p>
        <h2>Tres encuadres que cuentan historias distintas.</h2>
        <div class="shot-list">
          <div><span>A</span><p><strong>Frontal simétrico.</strong> Colócate en un paso peatonal seguro y usa el eje del carro para una composición clásica.</p></div>
          <div><span>B</span><p><strong>Diagonal con arbolado.</strong> Desde Oaxaca o Durango, incluye copas y terrazas para situar la fuente en Roma Norte.</p></div>
          <div><span>C</span><p><strong>Detalle de los leones.</strong> Un encuadre más cerrado funciona mejor cuando hay tránsito o demasiada gente alrededor.</p></div>
        </div>
        <p class="note">No te detengas en la calzada para tomar fotos. La glorieta está rodeada por circulación vehicular; utiliza pasos peatonales y banquetas.</p>
      </div>
    </div>
  </section>

  <section class="section section--sand" id="entorno">
    <div class="shell">
      <div class="section-heading split-heading">
        <div><p class="eyebrow">Llegar & moverse</p><h2>Roma Norte se disfruta mejor sin coche.</h2></div>
        <p>La fuente queda dentro de un tejido caminable y bien conectado. Metro, Metrobús, ECOBICI y rutas turísticas permiten combinarla fácilmente con Reforma, Condesa y el Centro.</p>
      </div>

      <div class="transport-grid">
        <article><span>Metro</span><h3>Línea 1</h3><p>Insurgentes y Sevilla son estaciones útiles para llegar caminando. Desde Insurgentes, continúa por Oaxaca / Durango hacia Plaza Villa de Madrid.</p></article>
        <article><span>Metrobús</span><h3>Corredor Insurgentes</h3><p>La estación Durango deja el entorno a pocos minutos a pie y es práctica si vienes desde el norte o sur de la ciudad.</p></article>
        <article><span>Bicicleta</span><h3>ECOBICI</h3><p>Hay estaciones de bici pública en el entorno inmediato de Plaza Villa de Madrid. Roma y Condesa tienen una red cómoda para trayectos cortos.</p></article>
        <article><span>Bus turístico</span><h3>Turibus / Capital Bus</h3><p>Los circuitos turísticos utilizan la glorieta como parada o punto de transferencia, útil si la visita forma parte de un recorrido amplio por CDMX.</p></article>
      </div>

      <div class="parking-card">
        <div><p class="eyebrow">Estacionamiento</p><h3>Si llegas en auto</h3></div>
        <div><p>No cuentes con un lugar junto a la fuente. Busca estacionamientos privados sobre Puebla, Durango o Medellín y revisa la señalización vigente de parquímetros y zonas restringidas antes de dejar el vehículo.</p><p class="muted">Tarifas, horarios y disponibilidad cambian; confirma directamente con el estacionamiento el día de tu visita.</p></div>
      </div>
    </div>
  </section>

  <section class="section shell map-section">
    <div class="map-copy">
      <p class="eyebrow">Ubicación</p>
      <h2>Plaza Villa de Madrid, Roma Norte.</h2>
      <p>{attraction.address}</p>
      <a class="text-link" href={attraction.mapUrl} target="_blank" rel="noreferrer">Cómo llegar en Google Maps →</a>
    </div>
    <div class="map-frame">
      <iframe src={mapEmbed} width="600" height="450" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="Mapa de la Fuente de Cibeles en Ciudad de México"></iframe>
    </div>
  </section>

  <section class="section section--ink">
    <div class="shell">
      <div class="section-heading split-heading on-dark">
        <div><p class="eyebrow light">Comer alrededor</p><h2>De pizza a mariscos: tres paradas para extender el paseo.</h2></div>
        <p>Roma Norte cambia rápido: revisa horario y disponibilidad antes de ir, especialmente en fines de semana.</p>
      </div>
      <div class="food-grid">
        <article><span>Frente a la plaza</span><h3>Cancino Cibeles</h3><p>Pizza, pasta y una ubicación que permite mantener la fuente dentro del paisaje del paseo.</p></article>
        <article><span>A unos minutos</span><h3>Contramar</h3><p>Un clásico de mariscos de la Roma, muy solicitado; la reserva suele ser conveniente.</p></article>
        <article><span>Para picar de todo</span><h3>Mercado Roma</h3><p>Formato de mercado gastronómico útil cuando el grupo quiere opciones distintas en un mismo lugar.</p></article>
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading">
      <p class="eyebrow">Cerca de Cibeles</p>
      <h2>Cuatro extensiones naturales del recorrido.</h2>
    </div>
    <div class="nearby-grid">
      <article><span>01</span><h3>Plaza Río de Janeiro</h3><p>Otra plaza emblemática de Roma Norte, rodeada de arquitectura histórica y cafés.</p><small>≈ 8–10 min a pie</small></article>
      <article><span>02</span><h3>Álvaro Obregón</h3><p>Camellón arbolado, fuentes, esculturas y uno de los paseos más característicos de la colonia.</p><small>≈ 10 min a pie</small></article>
      <article><span>03</span><h3>Ángel de la Independencia</h3><p>Conecta la visita con Paseo de la Reforma y uno de los símbolos urbanos más conocidos del país.</p><small>≈ 15–20 min a pie</small></article>
      <article><span>04</span><h3>Parque México</h3><p>Arquitectura art déco, áreas verdes y el corazón peatonal de la vecina Condesa.</p><small>≈ 15–20 min a pie</small></article>
    </div>
  </section>

  <section class="section section--sand">
    <div class="shell stay-grid">
      <div><p class="eyebrow">Dónde alojarse</p><h2>Elige barrio según el ritmo que quieras.</h2></div>
      <div class="stay-options">
        <article><h3>Roma Norte</h3><p>La mejor opción si quieres caminar a Cibeles, desayunos, restaurantes y galerías. Puede haber ruido nocturno en calles con bares.</p></article>
        <article><h3>Condesa</h3><p>Más verde y residencial, todavía a distancia caminable; funciona bien para quien prioriza parques y paseos tranquilos.</p></article>
        <article><h3>Juárez / Zona Rosa</h3><p>Práctica para Reforma y conexiones de transporte. Útil si la Fuente de Cibeles es una parada dentro de una agenda más amplia.</p></article>
      </div>
    </div>
  </section>

  <section id="faq" class="section shell faq-section">
    <div class="section-heading">
      <p class="eyebrow">Preguntas frecuentes</p>
      <h2>Lo esencial antes de ir.</h2>
    </div>
    <div class="faq-list">
      {faqs.map((item) => (
        <details>
          <summary>{item.q}<span aria-hidden="true">+</span></summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
    <p class="rating-note">* Calificación y número de reseñas proporcionados en la ficha de Google Maps indicada para este proyecto; pueden cambiar con el tiempo.</p>
  </section>
</BaseLayout>
